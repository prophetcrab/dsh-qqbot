{
  "name": "dsh-qqbot",
  "version": "0.1.1",
  "description": "QQ bot control center for DeepSeek Harness: one-click NapCat/Koishi setup, lifecycle management, a Koishi plugin manager, and an extensible feature registry.",
  "license": "MIT",
  "author": "prophetcrab",
  "homepage": "https://github.com/prophetcrab/dsh-qqbot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prophetcrab/dsh-qqbot.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qq",
    "qqbot",
    "napcat",
    "koishi",
    "onebot"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "scripts",
    "template",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SETUP.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "check": "npm test && npm run smoke:host && npm run smoke:client"
  }
}
